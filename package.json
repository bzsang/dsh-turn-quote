{
  "name": "dsh-turn-quote",
  "version": "0.2.0",
  "description": "Quote earlier turns of the current conversation into the composer from the @ menu — single turns, whole Q&A turns, or the last few turns, with body search — a DeepSeek Harness bundle.",
  "type": "module",
  "license": "MIT",
  "author": "Guodong Wang",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "composer",
    "mention",
    "quote",
    "earlier-turn",
    "multi-turn",
    "context"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bzsang/dsh-turn-quote.git"
  }
}